# BasicDigimonFlow

main: kit: flow: BasicDigimonFlow:
{
  entity: "digimon",
  kind: "basic",
  name: "BasicDigimonFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "digimon_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "digimon_ref01",
        srcdatavar: "digimon_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "digimon01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-digimon_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDigimonFlow"
}